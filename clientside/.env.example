# Copy this file to clientside/.env and fill it in. .env is git-ignored.
# Keep this file where the monitored user can't read or edit it (see README → Security).

# Shared secret for the primary API (required). Every /api/* request must send
#   Authorization: Bearer <PRIMARY_API_TOKEN>
# Put the SAME value in serverside/.env so the secondary API can reach it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRIMARY_API_TOKEN=change-me-to-a-long-random-token

# Address/port the primary API listens on. 0.0.0.0 = every network interface
# (needed when the secondary API runs on another machine). If the secondary API
# runs on this same PC, use 127.0.0.1 so nothing else on the network can reach it.
# PRIMARY_API_HOST=0.0.0.0
# PRIMARY_API_PORT=5000

# Run without the token (NOT recommended: anyone who can reach the port,
# including the monitored user, can change limits)
# PRIMARY_API_AUTH_DISABLED=false

# Home Assistant integration (optional, used by client_engine.py)
# HASS_URL=http://homeassistant.local:8123
# HASS_TOKEN=your_long_lived_access_token
