# Copy this file to serverside/.env and fill it in. .env is git-ignored.

# Address of the primary API on the kid's computer
PRIMARY_API_URL=http://localhost:5000/api

# Shared secret for the primary API (required). Must be the same value as
# PRIMARY_API_TOKEN in clientside/.env on the kid's computer.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PRIMARY_API_TOKEN=change-me-to-a-long-random-token

# Dashboard password (required). Use a long passphrase.
DASHBOARD_PASSWORD=change-me-to-a-long-passphrase

# Or store only a hash instead of the plain password (recommended):
#   python auth.py --hash
# then paste the printed line here and delete DASHBOARD_PASSWORD.
# DASHBOARD_PASSWORD_HASH='scrypt:32768:8:1$...'

# Optional: token for scripts/tools, sent as "Authorization: Bearer <token>"
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DASHBOARD_API_TOKEN=

# Embeddable widget (/widget) for homelab dashboards such as Homepage.
# Read-only token the widget can use when the iframe can't reach your sign-in
# cookie (e.g. the dashboard is on a different domain/IP). It only unlocks
# GET /api/widget/data. Put it in the iframe URL: /widget?key=<token>
# WIDGET_TOKEN=
# Sites allowed to show /widget in an iframe (space separated). Default: any.
# WIDGET_FRAME_ANCESTORS=https://home.example.com http://192.168.1.10:3000

# How long a sign-in lasts on a device (days)
# SESSION_DAYS=30

# Behind a reverse proxy (nginx, Caddy...) that sets X-Forwarded-For / -Proto
# TRUST_PROXY=true

# Force the Secure cookie flag (set this when the site is only reached over HTTPS)
# COOKIE_SECURE=true

# Run with no sign-in at all (NOT recommended)
# AUTH_DISABLED=false
